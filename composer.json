{
    "name": "dskripchenko/laravel-admin-media",
    "description": "Расширенная медиа-библиотека (коллекции, теги, focal-point, responsive-варианты) для dskripchenko/laravel-admin.",
    "type": "library",
    "keywords": [
        "laravel",
        "admin",
        "media",
        "media-library",
        "uploads",
        "images",
        "focal-point",
        "dskripchenko"
    ],
    "homepage": "https://github.com/dskripchenko/laravel-admin-media",
    "license": "MIT",
    "authors": [
        {
            "name": "Denis Skripchenko",
            "email": "denskrp90@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/dskripchenko/laravel-admin-media/issues",
        "source": "https://github.com/dskripchenko/laravel-admin-media"
    },
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "dskripchenko/laravel-admin": "^1.7"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "suggest": {
        "intervention/image": "Расширенный image processing (advanced filters, watermarks)",
        "ext-imagick": "Альтернатива GD с лучшим качеством и поддержкой большего числа форматов"
    },
    "autoload": {
        "psr-4": {
            "Dskripchenko\\LaravelAdminMedia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dskripchenko\\LaravelAdminMedia\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dskripchenko\\LaravelAdminMedia\\AdminMediaServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
